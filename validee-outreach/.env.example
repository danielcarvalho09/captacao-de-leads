# === Apify (Google Maps Scraper) ===
# Estes valores sao usados so para criar config/apify-config.json na primeira
# vez. Depois disso, tudo isso (incluindo o token) e editavel pelo painel web
# em /apify.html, sem precisar mexer no .env de novo.
APIFY_TOKEN=
APIFY_ACTOR_ID=compass/crawler-google-places
SEARCH_TERM=clinica de estetica
SEARCH_LOCATION=Belo Horizonte, MG, Brasil
MAX_LEADS=50

# Filtro de qualidade dos leads (rating do Google Maps)
MIN_RATING=3.5
MAX_RATING=5

# === Envio (WhatsApp) ===
# Estes 3 valores sao usados so para criar config/settings.json na primeira vez.
# Depois disso, o valor que vale e o que esta em config/settings.json (editavel
# pelo painel web em /copy). NUNCA remova o conceito de limite/janela, mesmo
# ajustando os numeros: e o que protege o numero de ban.
DAILY_LIMIT=15
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=120

# === Arquivos ===
LEADS_CSV_PATH=config/leads.csv
LOG_CSV_PATH=config/log-envios.csv
MESSAGE_TEMPLATE_PATH=config/message-template.txt

# === Painel web (npm run web) ===
PORT=3000

# Usuario/senha do painel web (HTTP Basic Auth). Deixe em branco so para uso
# local no seu computador. EM QUALQUER SERVIDOR/VPS EXPOSTO A INTERNET, defina
# os dois — sem isso qualquer pessoa que ache o IP consegue desconectar seu
# WhatsApp, trocar sua mensagem ou rodar o scraper gastando seus creditos.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Coloque "true" para o proprio painel web tambem rodar o scheduler de disparo
# (util na VPS, onde voce quer um unico processo cuidando de tudo). Em uso
# local, deixe em branco/false e rode `npm run send:schedule` a parte quando
# quiser testar o envio automatico.
ENABLE_SCHEDULER=false
